# A server's first TCP or UDP connection to each address and port, then nothing more to it for an hour (what it called
# there is in the audit log): every destination shows, a loop to one doesn't flood the journal. It logs before
# remembering, so with a set full (65536 in an hour) repeats show again rather than new ones going.
set seen4 { typeof meta skuid . ip daddr . th dport; flags timeout; timeout 1h; size 65536; }
set seen6 { typeof meta skuid . ip6 daddr . th dport; flags timeout; timeout 1h; size 65536; }

chain output {
  type filter hook output priority filter; policy accept;
  # No server opens another on this host past the edge's token check (a server per project gets another's).
  meta skuid { @users@ } ip daddr { @addresses@ } tcp dport { @ports@ } reject
  meta skuid { @users@ } ip6 daddr ::1 tcp dport { @ports@ } reject
  oifname "lo" accept
  ct state != new accept
  meta skuid . ip daddr . th dport @seen4 accept
  meta skuid . ip6 daddr . th dport @seen6 accept
@servers@
}
