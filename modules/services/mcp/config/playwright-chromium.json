{
  "browser": {
    "launchOptions": {
      "headless": false,
      "ignoreDefaultArgs": [
        "--enable-automation"
      ],
      "args": [
        "--disable-blink-features=AutomationControlled"
      ]
    },
    "contextOptions": {
      "viewport": {
        "width": 1440,
        "height": 900
      },
      "screen": {
        "width": 1920,
        "height": 1080
      },
      "locale": "en-GB"
    }
  }
}
