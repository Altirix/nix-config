// Supergateway in front of a project's REA: one stdio REA per MCP session, under /<project>/mcp.
// mcpServers gets the project's rea-gateway-project.json. JSONC, so the trailing commas are fine.
{
  "host": "127.0.0.1",
  "port": @port@,
  "outputTransport": "streamableHttp",
  "stateful": true,
  // Idle sessions end, and their REA (and its Ghidra) with them.
  "sessionTimeout": @sessionTimeout@,
  "mcpServers": {
@projects@
  },
}
