+def parse_net_names(pcb_text: str) -> set[str]:
+    """The net names a ``.kicad_pcb`` in the named-only dialect (``(net "name")``) uses on its pads and items."""
+    return {
+        re.sub(r"\\(.)", r"\1", match.group(1))
+        for match in re.finditer(r'\(net\s+"((?:\\.|[^"\\])*)"\)', pcb_text)
+        if match.group(1)
+    }
+
+
+def _net_token(name: str, net_numbers: dict[str, int], named_nets: set[str] | None) -> str:
+    if named_nets is None:
+        return str(net_numbers[name])
+    return '"' + name.replace("\\", "\\\\").replace('"', '\\"') + '"'
+
