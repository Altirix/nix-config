+"""Commands run in the background for a tool (route_krt_start, shell_run): output to a log, a time limit, cancel."""
+
+from __future__ import annotations
+
+import contextlib
+import os
+import signal
+import subprocess
+import threading
+import time
+from dataclasses import dataclass, field
+from pathlib import Path
+
+
+@dataclass
+class Job:
+    """One command, and how it ended."""
+
+    label: str
+    started: float
+    log_path: Path
+    process: subprocess.Popen[bytes]
+    returncode: int | None = None
+    finished: float | None = None
+    timed_out: bool = False
+    lock: threading.Lock = field(default_factory=threading.Lock)
+
+    @property
+    def done(self) -> bool:
+        with self.lock:
+            return self.finished is not None
+
+    def ending(self) -> str:
+        """How it ended, for a report: its exit code, or why it was stopped."""
+        with self.lock:
+            if self.timed_out:
+                return "stopped at its time limit"
+            if self.returncode == -signal.SIGKILL:
+                return "stopped (cancelled)"
+            return f"exit code {self.returncode}"
+
+    def took(self) -> str:
+        with self.lock:
+            end = self.finished if self.finished is not None else time.monotonic()
+        return minutes(end - self.started)
+
+
+def minutes(seconds: float) -> str:
+    return f"{int(seconds // 60)} min {int(seconds % 60)} s"
+
+
+def child_env(**extra: str) -> dict[str, str]:
+    """The server's environment without its own settings (KICAD_MCP_*, the KiCad API socket)."""
+    env = {key: value for key, value in os.environ.items() if not key.startswith(("KICAD_MCP_", "KICAD_API"))}
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    return env | extra
+
+
+def _yield(pid: int) -> None:
+    """Below the server and KiCad for CPU, and the first the kernel stops when memory runs out; what it starts
+    inherits both. Set from here (preexec_fn isn't safe in a threaded server), straight after it starts."""
+    with contextlib.suppress(OSError):
+        os.setpriority(os.PRIO_PROCESS, pid, 10)
+    with contextlib.suppress(OSError), open(f"/proc/{pid}/oom_score_adj", "w") as score:
+        score.write("1000")
+
+
+def start(argv: list[str], *, label: str, cwd: Path, log_path: Path, env: dict[str, str], max_minutes: float) -> Job:
+    """Start argv in a session of its own (so a cancel stops everything it starts), its output into log_path."""
+    log_path.parent.mkdir(parents=True, exist_ok=True)
+    with log_path.open("wb") as log:
+        process = subprocess.Popen(
+            argv,
+            cwd=cwd,
+            stdin=subprocess.DEVNULL,
+            stdout=log,
+            stderr=subprocess.STDOUT,
+            env=env,
+            start_new_session=True,
+        )
+    _yield(process.pid)
+    job = Job(label=label, started=time.monotonic(), log_path=log_path, process=process)
+    threading.Thread(target=_watch, args=(job, max(1.0, max_minutes) * 60), name="kicad-mcp-job", daemon=True).start()
+    return job
+
+
+def wait(job: Job, seconds: float) -> None:
+    """Wait up to seconds (at most a minute) for it to end."""
+    deadline = time.monotonic() + max(0.0, min(seconds, 60))
+    while time.monotonic() < deadline and not job.done:
+        time.sleep(0.2)
+
+
+def kill(job: Job) -> None:
+    with contextlib.suppress(ProcessLookupError):
+        os.killpg(job.process.pid, signal.SIGKILL)
+
+
+def output(job: Job) -> str:
+    try:
+        return job.log_path.read_text(encoding="utf-8", errors="replace")
+    except OSError:
+        return ""
+
+
+def _watch(job: Job, timeout: float) -> None:
+    try:
+        job.process.wait(timeout=timeout)
+    except subprocess.TimeoutExpired:
+        with job.lock:
+            job.timed_out = True
+        kill(job)
+        job.process.wait()
+    with job.lock:
+        job.returncode = job.process.returncode
+        job.finished = time.monotonic()
