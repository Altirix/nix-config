+"""A step after every tool call that changes the project: its files as they are then, a commit on refs/kicad-mcp/steps.
+
+Steps go through an index of their own, so the project's index, branches and commits are never touched, and they
+are never pushed (pushes are branches only). The first step's parent is the commit checked out then; after that
+each step's parent is the step before, also across branch switches. Nothing changed, no step. What git ignores
+(the excludes file, .gitignore) is left out, as in a commit. The open board is saved first, so its live edits are
+in the step.
+"""
+
+# pyright: reportUnusedFunction=false
+
+from __future__ import annotations
+
+import os
+import subprocess
+import threading
+from pathlib import Path
+
+import structlog
+from mcp.server.mcpserver import MCPServer as FastMCP
+
+from ..capabilities import AccessTier
+from ..capabilities import get as capability
+from ..config import get_config
+from .metadata import headless_compatible
+
+logger = structlog.get_logger(__name__)
+
+REF = "refs/kicad-mcp/steps"
+_IDENTITY = {
+    "GIT_AUTHOR_NAME": "KiCad MCP steps",
+    "GIT_AUTHOR_EMAIL": "steps@kicad-mcp",
+    "GIT_COMMITTER_NAME": "KiCad MCP steps",
+    "GIT_COMMITTER_EMAIL": "steps@kicad-mcp",
+}
+_LOCK = threading.Lock()
+# Tools that change the open board: it's saved before their step.
+_BOARD_PREFIXES = ("pcb_", "route_", "kicad_ipc", "board_", "zone_")
+# Argument names that say what a call was about, for the step's message.
+_SUBJECT_KEYS = ("path", "file", "command", "script", "reference", "name", "net", "message", "step")
+
+
+def _git(*args: str, env: dict[str, str] | None = None, check: bool = True) -> str:
+    root = get_config().workspace
+    result = subprocess.run(
+        ["git", "-C", str(root), *args],
+        capture_output=True,
+        text=True,
+        env=env,
+        timeout=120,
+    )
+    if check and result.returncode != 0:
+        raise RuntimeError(f"git {args[0]}: {result.stderr.strip() or result.stdout.strip()}")
+    return result.stdout.strip()
+
+
+def _env() -> dict[str, str]:
+    git_dir = Path(_git("rev-parse", "--absolute-git-dir"))
+    return dict(os.environ, GIT_INDEX_FILE=str(git_dir / "kicad-mcp-steps.index"), **_IDENTITY)
+
+
+def _subject(tool: str, arguments: dict[str, object]) -> str:
+    for key in _SUBJECT_KEYS:
+        value = arguments.get(key)
+        if isinstance(value, str) and value:
+            value = " ".join(value.split())
+            return f"{tool}: {value[:120]}"
+    return tool
+
+
+def changes_files(tool: str) -> bool:
+    """Whether a call may change the project: everything but the read tools."""
+    record = capability(tool)
+    return record is None or record.tier is not AccessTier.READ
+
+
+def _save_board(tool: str, arguments: dict[str, object]) -> None:
+    if not tool.startswith(_BOARD_PREFIXES) or tool == "pcb_save":
+        return
+    command = str(arguments.get("command") or "")
+    if tool == "kicad_ipc" and command.rsplit(".", 1)[-1].startswith("Get"):  # KiCad's API reads change nothing
+        return
+    from .pcb import _native_live_transaction_active
+    from .routing_krt import _save_open_board
+
+    if not _native_live_transaction_active():  # a staged transaction is saved when it's committed
+        _save_open_board()
+
+
+def record(tool: str, arguments: dict[str, object]) -> str | None:
+    """Make a step after a tool call, if the project's files changed; its commit, else None."""
+    if not changes_files(tool):
+        return None
+    with _LOCK:
+        try:
+            _save_board(tool, arguments)
+            env = _env()
+            latest = _git("rev-parse", "--verify", "--quiet", REF, check=False)
+            parent = latest or _git("rev-parse", "--verify", "--quiet", "HEAD", check=False)
+            if not Path(env["GIT_INDEX_FILE"]).exists() and parent:
+                _git("read-tree", parent, env=env)
+            _git("add", "--all", env=env)
+            tree = _git("write-tree", env=env)
+            if parent and tree == _git("rev-parse", f"{parent}^{{tree}}"):
+                return None
+            commit = _git(
+                "commit-tree", tree, *(["-p", parent] if parent else []), "-m", _subject(tool, arguments), env=env
+            )
+            _git("update-ref", REF, commit, latest)  # only from the step it was made on ("": none yet)
+            return commit
+        except Exception as exc:  # noqa: BLE001 - a step is never worth failing the call it records
+            logger.warning("step_failed", tool=tool, error=str(exc)[:300])
+            return None
+
+
+def register(mcp: FastMCP) -> None:
+    """Register the step tools."""
+
+    @mcp.tool()
+    @headless_compatible
+    def vcs_list_steps(limit: int = 30) -> str:
+        """The latest steps, newest first: a step is made after every tool call that changed the project's files.
+
+        Each line: the step, when, the call that made it, and the files it changed. vcs_diff_steps shows what one
+        changed, pcb_render_png(step=...) shows the board then, vcs_restore_step goes back to one.
+        """
+        if not _git("rev-parse", "--verify", "--quiet", REF, check=False):
+            return "No steps yet: one is made after the first tool call that changes a file."
+        out = _git(
+            "log", "--first-parent", f"-n{max(1, min(limit, 200))}", "--name-only",
+            "--format=%x00%h%x09%ad%x09%ae%x09%s", "--date=format:%Y-%m-%d %H:%M:%S", REF,
+        )
+        lines = []
+        for entry in out.split("\x00")[1:]:
+            head, _, names = entry.partition("\n")
+            short, when, email, subject = (head.split("\t") + ["", "", "", ""])[:4]
+            if email != _IDENTITY["GIT_AUTHOR_EMAIL"]:
+                lines.append(f"{short} {when} (commit: {subject}): where the steps start")
+                break
+            files = [name for name in names.split("\n") if name]
+            shown = ", ".join(files[:6]) + (f" and {len(files) - 6} more" if len(files) > 6 else "")
+            lines.append(f"{short} {when} {subject}: {shown}")
+        return "\n".join(lines)
+
+    @mcp.tool()
+    @headless_compatible
+    def vcs_diff_steps(step: str, to: str = "", path: str = "", patch: bool = False, max_chars: int = 20000) -> str:
+        """What a step changed (from the one before it), or everything between step and to (a step, commit or
+        branch). path keeps it to those files. patch=true shows the lines, else the files and how much."""
+        old, new = (f"{step}^", step) if not to else (step, to)
+        args = ["diff", "--find-renames", old, new, *(["--", path] if path else [])]
+        out = _git(*args) if patch else _git(*args[:1], "--stat=160", *args[1:])
+        if not out:
+            return "No changes."
+        if len(out) > max_chars:
+            out = out[:max_chars] + f"\n... [{len(out) - max_chars} more characters: narrow it with path]"
+        return out
+
+    @mcp.tool()
+    @headless_compatible
+    def vcs_restore_step(step: str, paths: list[str] | None = None) -> str:
+        """Put the project's files back as they were at a step (vcs_list_steps): all of them, or only paths.
+
+        Restoring all of them also removes files made since. KiCad reloads the board. The restore is a step
+        itself, so it can be undone the same way. Commits and branches are unchanged: commit to keep it.
+        """
+        if not _git("rev-parse", "--verify", "--quiet", f"{step}^{{commit}}", check=False):
+            return f"No step {step!r}: vcs_list_steps."
+        latest = _git("rev-parse", REF)
+        if paths:
+            _git("restore", f"--source={step}", "--worktree", "--", *paths)
+        else:
+            added = _git("diff", "--name-only", "--diff-filter=A", "-z", step, latest).split("\x00")
+            root = get_config().workspace
+            for name in filter(None, added):
+                (root / name).unlink(missing_ok=True)
+            _git("restore", f"--source={step}", "--worktree", "--", ":/")
+        from .pcb import _reload_board_after_file_sync
+
+        try:
+            reload = _reload_board_after_file_sync()
+        except Exception as exc:  # noqa: BLE001 - the files are back; KiCad opens them when it's next asked
+            reload = f"KiCad couldn't be asked to reload the board ({str(exc)[:200]})."
+        return f"Restored {', '.join(paths) if paths else 'every file'} as at {step}. {reload}"
