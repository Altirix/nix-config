@@ -0,0 +1,396 @@
+"""The project as a workspace: its files, a shell in it, KiCad's API as it is, and the board as an image.
+
+Everything stays in the project's repo (the workspace root): paths outside it, and its .git, are refused; git goes
+through the vcs_* tools or the shell. Every call that changes something is a step (steps.py).
+"""
+
+# pyright: reportUnusedFunction=false
+
+from __future__ import annotations
+
+import base64
+import importlib
+import itertools
+import json
+import os
+import pkgutil
+import shutil
+import subprocess
+from pathlib import Path
+from typing import Any
+
+from mcp.server.mcpserver import MCPServer as FastMCP
+from mcp.types import CallToolResult
+
+from ..config import get_config
+from ..mcp_media import image_tool_result, text_tool_result
+from . import board_render, jobs
+from .metadata import headless_compatible
+
+_READ_LINES = 400
+_READ_CHARS = 60_000
+_LINE_CHARS = 2_000
+_OUTPUT_HEAD = 2_000
+_OUTPUT_TAIL = 10_000
+_MAX_RUNNING = 4
+_MAX_BINARY = 8 * 1024 * 1024
+_IMAGES = {".png", ".jpg", ".jpeg", ".gif", ".webp"}
+_SHELL: dict[str, jobs.Job] = {}
+_SHELL_IDS = itertools.count(1)
+
+
+def _root() -> Path:
+    return get_config().workspace.resolve()
+
+
+def _path(path: str, *, write: bool = False) -> Path:
+    """A path in the project (relative to its root, or absolute inside it); never its .git."""
+    root = _root()
+    target = (root / path).resolve()
+    if not target.is_relative_to(root):
+        raise ValueError(f"{path!r} is outside the project ({root}).")
+    if ".git" in target.relative_to(root).parts:
+        raise ValueError("The project's .git is off limits: use the vcs_* tools, or git in shell_run.")
+    if write and target.is_dir():
+        raise ValueError(f"{path!r} is a folder.")
+    return target
+
+
+def _shown(target: Path) -> str:
+    return str(target.relative_to(_root())) or "."
+
+
+def _clip_output(text: str) -> str:
+    if len(text) <= _OUTPUT_HEAD + _OUTPUT_TAIL:
+        return text
+    cut = len(text) - _OUTPUT_HEAD - _OUTPUT_TAIL
+    return f"{text[:_OUTPUT_HEAD]}\n... [{cut} characters left out] ...\n{text[-_OUTPUT_TAIL:]}"
+
+
+def _after_write(target: Path) -> str:
+    """KiCad reloads the open board when its file was written."""
+    from .pcb import _get_pcb_file_for_sync, _reload_board_after_file_sync
+
+    try:
+        if target == _get_pcb_file_for_sync().resolve():
+            return " " + _reload_board_after_file_sync()
+    except Exception as exc:  # noqa: BLE001 - written either way; KiCad opens the new file when it's next asked
+        return f" KiCad couldn't be asked to reload the board ({str(exc)[:200]})."
+    return ""
+
+
+def _write(target: Path, data: str | bytes) -> None:
+    target.parent.mkdir(parents=True, exist_ok=True)
+    temp = target.with_name(f".{target.name}.kicad-mcp-tmp")
+    if isinstance(data, bytes):
+        temp.write_bytes(data)
+    else:
+        temp.write_text(data, encoding="utf-8")
+    if target.exists():
+        shutil.copymode(target, temp)
+    else:
+        temp.chmod(0o666 & ~_umask())
+    temp.replace(target)
+
+
+def _umask() -> int:
+    mask = os.umask(0)
+    os.umask(mask)
+    return mask
+
+
+def _shell_report(job_id: str, job: jobs.Job) -> str:
+    out = _clip_output(jobs.output(job)).rstrip() or "(no output)"
+    if not job.done:
+        return (
+            f"Job {job_id} running for {job.took()}: {job.label}\n{out[-_OUTPUT_TAIL // 5 :]}\n"
+            f"shell_status(job={job_id!r}) for more, shell_cancel to stop it."
+        )
+    return f"Job {job_id} finished after {job.took()}, {job.ending()}: {job.label}\n{out}"
+
+
+def _proto_modules() -> None:
+    """Import every message KiCad's API defines, so a request can be named and its answer read."""
+    import kipy.proto
+
+    for module in pkgutil.walk_packages(kipy.proto.__path__, "kipy.proto."):
+        if module.name.endswith("_pb2"):
+            importlib.import_module(module.name)
+
+
+def _message_class(name: str) -> type[Any]:
+    from google.protobuf import message_factory, symbol_database
+
+    _proto_modules()
+    pool = symbol_database.Default().pool
+    candidates = [name] if "." in name else [
+        f"kiapi.{area}.commands.{name}" for area in ("common", "board", "schematic")
+    ]
+    for full in candidates:
+        try:
+            return message_factory.GetMessageClass(pool.FindMessageTypeByName(full))
+        except KeyError:
+            continue
+    raise ValueError(f"KiCad's API has no request {name!r}: kicad_ipc() lists them.")
+
+
+def _commands() -> list[str]:
+    import kipy.proto
+
+    _proto_modules()
+    names = []
+    for module in pkgutil.walk_packages(kipy.proto.__path__, "kipy.proto."):
+        if module.name.endswith("commands_pb2") or ".commands." in module.name:
+            descriptor = getattr(importlib.import_module(module.name), "DESCRIPTOR", None)
+            if descriptor is not None:
+                names += [
+                    f"{descriptor.package}.{n}" for n in descriptor.message_types_by_name if not n.endswith("Response")
+                ]
+    return sorted(set(names))
+
+
+def _fill_document(message: Any, document: Any) -> None:
+    """Point every unset DocumentSpecifier in the request (at the top, or in its header) at the open board."""
+    for field in message.DESCRIPTOR.fields:
+        repeated = field.is_repeated if hasattr(field, "is_repeated") else field.label == field.LABEL_REPEATED
+        if field.message_type is None or repeated:
+            continue
+        if field.message_type.full_name == "kiapi.common.types.DocumentSpecifier":
+            if not message.HasField(field.name):
+                getattr(message, field.name).CopyFrom(document)
+        elif field.name == "header":
+            _fill_document(getattr(message, field.name), document)
+
+
+def _send_raw(command: Any) -> dict[str, Any]:
+    """KiCadClient.send, but the answer is read as whatever type KiCad says it is."""
+    import pynng
+    from google.protobuf import json_format, message_factory, symbol_database
+    from kipy.errors import ApiError
+    from kipy.proto.common import ApiRequest, ApiResponse, ApiStatusCode
+
+    from ..connection import get_board
+
+    board = get_board()  # opens the selected board in the headless KiCad
+    kicad = board._kicad  # noqa: SLF001 - the one connection kipy holds: a KiCadClient, or a KiCad around one
+    client = getattr(kicad, "_client", kicad)
+    if not client.connected:
+        client._connect()  # noqa: SLF001
+    envelope = ApiRequest()
+    envelope.message.Pack(command)
+    envelope.header.kicad_token = client._kicad_token  # noqa: SLF001
+    envelope.header.client_name = client._client_name  # noqa: SLF001
+    try:
+        client._conn.send(envelope.SerializeToString())  # noqa: SLF001
+        data = client._conn.recv_msg().bytes  # noqa: SLF001
+    except pynng.exceptions.NNGException as exc:
+        client._connected = False  # noqa: SLF001
+        raise ConnectionError(f"KiCad's API didn't answer: {exc}") from None
+    reply = ApiResponse()
+    reply.ParseFromString(data)
+    if reply.status.status != ApiStatusCode.AS_OK:
+        raise ApiError(f"KiCad returned error: {reply.status.error_message}", raw_message=reply.status.error_message,
+                       code=reply.status.status)
+    type_name = reply.message.type_url.rsplit("/", 1)[-1]
+    if not type_name:
+        return {"type": "", "message": {}}
+    pool = symbol_database.Default().pool
+    answer = message_factory.GetMessageClass(pool.FindMessageTypeByName(type_name))()
+    reply.message.Unpack(answer)
+    return {"type": type_name, "message": json_format.MessageToDict(answer, preserving_proto_field_name=True)}
+
+
+def register(mcp: FastMCP) -> None:
+    """Register the workspace tools."""
+
+    @mcp.tool()
+    @headless_compatible
+    def file_list(path: str = ".", pattern: str = "*", recursive: bool = False, limit: int = 500) -> str:
+        """Files and folders in the project (folders end in /), with sizes. pattern is a glob (*.kicad_sch);
+        recursive goes into subfolders. .git is left out."""
+        base = _path(path)
+        if not base.is_dir():
+            raise ValueError(f"{path!r} isn't a folder.")
+        found = base.rglob(pattern) if recursive else base.glob(pattern)
+        entries = []
+        for item in sorted(found):
+            if ".git" in item.relative_to(_root()).parts:
+                continue
+            entries.append(f"{_shown(item)}/" if item.is_dir() else f"{_shown(item)} ({item.stat().st_size} B)")
+            if len(entries) >= limit:
+                entries.append("... more: raise limit, or narrow pattern")
+                break
+        return "\n".join(entries) or "Nothing there."
+
+    @mcp.tool()
+    @headless_compatible
+    def file_read(path: str, offset: int = 1, limit: int = _READ_LINES, encoding: str = "text") -> CallToolResult:
+        """A file from the project. Text comes with its lines numbered, from line offset, limit lines at a time (a
+        board or schematic is S-expressions: file_search finds what to read). An image (PNG, JPEG, GIF, WebP) comes
+        as an image. Any other binary file (a PDF, a STEP model) with encoding="base64", up to 8 MB."""
+        target = _path(path)
+        if target.suffix.lower() in _IMAGES and encoding == "text":
+            return image_tool_result(target, {"path": _shown(target), "bytes": target.stat().st_size})
+        data = target.read_bytes()
+        if encoding == "base64":
+            if len(data) > _MAX_BINARY:
+                raise ValueError(f"{_shown(target)} is {len(data)} B, more than 8 MB.")
+            return text_tool_result(base64.b64encode(data).decode("ascii"),
+                                    metadata={"path": _shown(target), "bytes": len(data), "encoding": "base64"})
+        if b"\0" in data[:8192]:
+            return text_tool_result(f"{_shown(target)} is binary ({len(data)} B): encoding=\"base64\" to get it.")
+        lines = data.decode("utf-8", errors="replace").splitlines()
+        start = max(1, offset)
+        out, size = [], 0
+        for number in range(start, min(len(lines), start + max(1, limit) - 1) + 1):
+            line = lines[number - 1]
+            line = line if len(line) <= _LINE_CHARS else line[:_LINE_CHARS] + " ..."
+            size += len(line)
+            if size > _READ_CHARS:
+                break
+            out.append(f"{number:>6}\t{line}")
+        last = start + len(out) - 1
+        more = f"\n[lines {start}-{last} of {len(lines)}: offset={last + 1} for more]" if last < len(lines) else ""
+        return text_tool_result("\n".join(out) + more)
+
+    @mcp.tool()
+    @headless_compatible
+    def file_search(
+        pattern: str, path: str = ".", glob: str = "", ignore_case: bool = False, limit: int = 200
+    ) -> str:
+        """Lines matching a regular expression (extended) in the project's files, as file:line:text. glob keeps
+        it to some files (*.kicad_pcb). Files git ignores are left out."""
+        base = _path(path)
+        where = _shown(base)
+        spec = where if not glob else f":(glob){'' if where == '.' else where + '/'}**/{glob}"
+        result = subprocess.run(
+            ["git", "-C", str(_root()), "grep", "-n", "-I", "-E", "--untracked", *(["-i"] if ignore_case else []),
+             "-e", pattern, "--", spec],
+            capture_output=True, text=True, timeout=120,
+        )
+        if result.returncode == 1:
+            return "No matches."
+        if result.returncode != 0:
+            raise ValueError(result.stderr.strip())
+        lines = [line[:_LINE_CHARS] for line in result.stdout.splitlines()]
+        more = f"\n... {len(lines) - limit} more: narrow it" if len(lines) > limit else ""
+        return "\n".join(lines[:limit]) + more
+
+    @mcp.tool()
+    @headless_compatible
+    def file_write(path: str, content: str, encoding: str = "text") -> str:
+        """Write a file in the project, whole (made if it's new, folders too). encoding="base64" for a binary file (a
+        datasheet PDF, a 3D model, an image), content its base64, up to 8 MB. KiCad reloads the board when it's the
+        open board's file. For a change inside a text file, file_edit."""
+        target = _path(path, write=True)
+        data: str | bytes = content
+        if encoding == "base64":
+            data = base64.b64decode(content, validate=True)
+            if len(data) > _MAX_BINARY:
+                raise ValueError(f"{len(data)} B is more than 8 MB.")
+        elif encoding != "text":
+            raise ValueError('encoding is "text" or "base64".')
+        _write(target, data)
+        size = len(data) if isinstance(data, bytes) else len(data.encode())
+        return f"Wrote {_shown(target)} ({size} B).{_after_write(target)}"
+
+    @mcp.tool()
+    @headless_compatible
+    def file_edit(path: str, old: str, new: str, replace_all: bool = False) -> str:
+        """Replace old with new in a project file. old must be there exactly once, unless replace_all."""
+        target = _path(path, write=True)
+        text = target.read_text(encoding="utf-8")
+        count = text.count(old)
+        if count == 0 or not old:
+            raise ValueError(f"old isn't in {_shown(target)}: copy it exactly, with its whitespace (file_read).")
+        if count > 1 and not replace_all:
+            raise ValueError(f"old is in {_shown(target)} {count} times: give more around it, or replace_all.")
+        _write(target, text.replace(old, new))
+        return f"Replaced {count} in {_shown(target)}.{_after_write(target)}"
+
+    @mcp.tool()
+    @headless_compatible
+    def shell_run(command: str, cwd: str = ".", wait_seconds: float = 60, max_minutes: float = 60) -> str:
+        """Run a bash command in the project, as its server: kicad-cli, git (its remote goes through the push
+        gate), python3 with numpy, scipy, shapely and Pillow, KiCadRoutingTools in $KRT (python3
+        $KRT/py_router/route.py ...). Only the project and the server's own state ($HOME) are writable, and no other
+        project is there.
+
+        Returns its output when it ends within wait_seconds (at most 60); otherwise it runs on as a job,
+        shell_status(job) reports it and shell_cancel stops it. max_minutes stops it. Output is cut to its first
+        2,000 and last 10,000 characters; the whole of it is in .kicad-mcp/shell/<job>.log.
+        """
+        running = [job_id for job_id, job in _SHELL.items() if not job.done]
+        if len(running) >= _MAX_RUNNING:
+            raise ValueError(f"{len(running)} jobs are running ({', '.join(running)}): wait, or shell_cancel one.")
+        directory = _path(cwd)
+        job_id = str(next(_SHELL_IDS))
+        krt = os.environ.get("KICAD_MCP_KRT_DIR", "")
+        # KRT's Python first: the server's own launcher puts its Python (no numpy) ahead of the unit's PATH.
+        python = os.environ.get("KICAD_MCP_KRT_PYTHON", "")
+        path = os.pathsep.join(filter(None, [str(Path(python).parent) if python else "", os.environ.get("PATH", "")]))
+        _SHELL[job_id] = job = jobs.start(
+            [shutil.which("bash") or "/bin/sh", "-c", command],
+            label=command if len(command) <= 200 else command[:200] + " ...",
+            cwd=directory,
+            log_path=_root() / ".kicad-mcp" / "shell" / f"{job_id}.log",
+            env=jobs.child_env(KRT=krt, PATH=path),
+            max_minutes=max_minutes,
+        )
+        jobs.wait(job, wait_seconds)
+        return _shell_report(job_id, job)
+
+    @mcp.tool()
+    @headless_compatible
+    def shell_status(job: str = "") -> str:
+        """A shell_run job's output so far, or how it ended. No job lists them all."""
+        if not job:
+            return "\n".join(
+                f"{job_id}: {j.ending() if j.done else 'running'}, {j.took()}: {j.label}"
+                for job_id, j in _SHELL.items()
+            ) or "No jobs yet."
+        if job not in _SHELL:
+            raise ValueError(f"No job {job!r}: shell_status() lists them.")
+        return _shell_report(job, _SHELL[job])
+
+    @mcp.tool()
+    @headless_compatible
+    def shell_cancel(job: str) -> str:
+        """Stop a shell_run job and everything it started."""
+        if job not in _SHELL:
+            raise ValueError(f"No job {job!r}: shell_status() lists them.")
+        if _SHELL[job].done:
+            return f"Job {job} already ended: {_SHELL[job].ending()}."
+        jobs.kill(_SHELL[job])
+        return f"Stopped job {job} after {_SHELL[job].took()}."
+
+    @mcp.tool()
+    @headless_compatible
+    def kicad_ipc(command: str = "", message: dict[str, Any] | None = None, fill_document: bool = True,
+                  max_chars: int = 30000) -> str:
+        """Send one request to KiCad's own API (protobuf, as JSON) on the open board, and return its answer.
+
+        command: a request's name, short (GetItems, GetBoardStackup, CreateItems, BeginCommit) or full
+        (kiapi.board.commands.GetItems); no command lists them all. message: its fields as JSON, as KiCad's API
+        defines them (field names as in its .proto files). fill_document points any document field left unset
+        at the open board. Edits made this way are live, like the pcb_* tools': wrap several in BeginCommit and
+        EndCommit for one undo step, and the board is saved into the call's step.
+        """
+        if not command:
+            return "KiCad's API requests:\n" + "\n".join(_commands())
+        from google.protobuf import json_format
+
+        from ..connection import get_board
+        from .pcb import _run_queued_ipc_mutation
+
+        request = _message_class(command)()
+        json_format.ParseDict(message or {}, request)
+        if fill_document:
+            _fill_document(request, get_board().document)
+        answer = _run_queued_ipc_mutation("kicad_ipc", lambda: _send_raw(request))
+        text = json.dumps(answer, indent=1)
+        if len(text) > max_chars:
+            text = text[:max_chars] + f"\n... [{len(text) - max_chars} more characters: ask for less, or raise max_chars]"
+        return text
+
+    board_render.register(mcp)
