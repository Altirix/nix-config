+    @mcp.tool()
+    @headless_compatible
+    @requires_dependency("freerouting")
+    def route_autoroute_start(
+        dsn_path: str = "output/routing/board.dsn",
+        ses_path: str = "output/routing/board.ses",
+        net_classes_to_ignore: list[str] | None = None,
+        exclude_nets: list[str] | None = None,
+        max_passes: int = 100,
+        thread_count: int = 4,
+    ) -> str:
+        """Start route_autoroute_freerouting in the background and return straight away.
+
+        A real board takes FreeRouting many minutes, longer than a client waits for one call. Check on it with
+        route_autoroute_status every 5-10 minutes; when it's done, that returns the result, already applied to
+        the board. Don't edit the board meanwhile: the result is written to its file, and live edits not yet saved
+        are lost when KiCad reloads it.
+        """
+        global _JOB
+        if _JOB is not None and _JOB.finished is None:
+            return f"An autoroute is already running ({_minutes(time.monotonic() - _JOB.started)}): route_autoroute_status."
+        log_path = get_config().resolve_within_project(Path(dsn_path)).with_suffix(".freerouting.log")
+        log_path.unlink(missing_ok=True)
+        job = _AutorouteJob(started=time.monotonic(), log_path=log_path)
+
+        def run() -> None:
+            try:
+                result = anyio.run(
+                    lambda: deps.service.autoroute(
+                        dsn_path=dsn_path,
+                        ses_path=ses_path,
+                        net_classes_to_ignore=net_classes_to_ignore,
+                        exclude_nets=exclude_nets,
+                        max_passes=max_passes,
+                        thread_count=thread_count,
+                        use_docker=False,
+                        freerouting_jar_path=None,
+                        drc_report_path="output/routing/freerouting.drc.json",
+                        report_progress=None,
+                    )
+                )
+                with job.lock:
+                    job.result = result
+            except Exception as exc:  # noqa: BLE001 - reported by route_autoroute_status
+                with job.lock:
+                    job.error = f"{type(exc).__name__}: {exc}"
+            finally:
+                with job.lock:
+                    job.finished = time.monotonic()
+
+        job.thread = threading.Thread(target=run, name="kicad-mcp-autoroute", daemon=True)
+        _JOB = job
+        job.thread.start()
+        return (
+            "Autoroute started in the background. Check it with route_autoroute_status every 5-10 minutes; "
+            "leave the board alone until it's done."
+        )
+
+    @mcp.tool()
+    @headless_compatible
+    def route_autoroute_status() -> ToolResult:
+        """How the background autoroute (route_autoroute_start) is getting on, or its result once it's done."""
+        job = _JOB
+        if job is None:
+            return ToolResult.failure("route_autoroute_status", "No autoroute has been started: route_autoroute_start.")
+        with job.lock:
+            finished, result, error = job.finished, job.result, job.error
+        if finished is None:
+            summary = "\n".join(
+                [f"Autoroute running for {_minutes(time.monotonic() - job.started)}.", *_progress_lines(job.log_path),
+                 "Check again in 5-10 minutes."]
+            )
+            return ToolResult.success("route_autoroute_status", changed=False, state_delta=StateDelta(summary=summary))
+        took = _minutes(finished - job.started)
+        if error is not None:
+            return ToolResult.failure("route_autoroute_status", f"Autoroute failed after {took}: {error}")
+        assert result is not None
+        summary = f"Finished after {took}.\n{result.state_delta.summary}"
+        return result.model_copy(update={"state_delta": result.state_delta.model_copy(update={"summary": summary})})
