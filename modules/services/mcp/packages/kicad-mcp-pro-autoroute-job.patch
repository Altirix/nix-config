+@dataclass
+class _AutorouteJob:
+    """The one autoroute running in the background (route_autoroute_start), and how it ended."""
+
+    started: float
+    log_path: Path
+    thread: threading.Thread | None = None
+    result: ToolResult | None = None
+    error: str | None = None
+    finished: float | None = None
+    lock: threading.Lock = field(default_factory=threading.Lock)
+
+
+_JOB: _AutorouteJob | None = None
+
+
+def _minutes(seconds: float) -> str:
+    return f"{int(seconds // 60)} min {int(seconds % 60)} s"
+
+
+def _progress_lines(log_path: Path) -> list[str]:
+    """FreeRouting's latest progress from its log: the passes so far and its last word."""
+    try:
+        text = log_path.read_text(encoding="utf-8", errors="replace")
+    except OSError:
+        return ["FreeRouting hasn't written anything yet (still exporting or starting)."]
+    passes = re.findall(r"Auto-router pass #(\d+).*?score of ([0-9]+(?:\.[0-9]+)?)", text)
+    lines = []
+    if passes:
+        number, score = passes[-1]
+        lines.append(f"- Passes done: {number}, latest score {score}")
+    else:
+        lines.append("- No pass finished yet")
+    last = [
+        line.strip()
+        for line in text.splitlines()
+        if line.strip() and "pass #" not in line and "new version" not in line
+    ]
+    if last:
+        lines.append(f"- Last message: {last[-1][:300]}")
+    return lines
+
