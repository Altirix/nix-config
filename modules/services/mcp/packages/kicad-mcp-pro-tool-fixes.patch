+def _existing_copper(pcb_text: str, net_numbers: dict[str, int]) -> tuple[set[object], set[object]]:
+    """Keys of the board's tracks and vias: net, layer, ends (either way round), width; net, position, size."""
+    names = {number: name for name, number in net_numbers.items()}
+    number = r"(-?[0-9.]+)"
+    segments: set[object] = set()
+    vias: set[object] = set()
+    for match in re.finditer(r"\((segment|via)[\s(]", pcb_text):
+        block, _ = _extract_block(pcb_text, match.start())
+        net_match = re.search(r'\(net\s+(?:"((?:[^"\\]|\\.)*)"|(\d+))', block)
+        if net_match is None:
+            continue
+        net = net_match.group(1) if net_match.group(1) is not None else names.get(int(net_match.group(2)), "")
+        net = re.sub(r"\\(.)", r"\1", net)
+        if match.group(1) == "segment":
+            start = re.search(r"\(start\s+" + number + r"\s+" + number, block)
+            end = re.search(r"\(end\s+" + number + r"\s+" + number, block)
+            width = re.search(r"\(width\s+" + number, block)
+            layer = re.search(r'\(layer\s+"?([^"\s)]+)', block)
+            if start and end and width and layer:
+                ends = frozenset({(round(float(start[1]), 4), round(float(start[2]), 4)),
+                                  (round(float(end[1]), 4), round(float(end[2]), 4))})
+                segments.add((net, layer[1], ends, round(float(width[1]), 4)))
+        else:
+            at = re.search(r"\(at\s+" + number + r"\s+" + number, block)
+            size = re.search(r"\(size\s+" + number, block)
+            if at and size:
+                vias.add((net, (round(float(at[1]), 4), round(float(at[2]), 4)), round(float(size[1]), 4)))
+    return segments, vias
+
