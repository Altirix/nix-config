+_EXCLUDED_CLASS = "kicad_mcp_excluded"
+
+
+def _exclude_dsn_nets(text: str, names: set[str]) -> str:
+    """The DSN with these nets moved into a class of their own, _EXCLUDED_CLASS, for FreeRouting to skip (-inc).
+
+    The nets stay in the DSN, so their tracks, vias and zones are still obstacles it routes around; it only takes
+    net class names to skip, not net names. The new class gets the rules of the first class a net came from.
+    """
+    from ..utils.sexpr import _extract_block
+
+    def unquote(token: str) -> str:
+        return token[1:-1] if len(token) >= 2 and token[0] == token[-1] == '"' else token
+
+    token = r'("(?:[^"\\]|\\.)*"|[^\s()]+)'
+    out: list[str] = []
+    pos = 0
+    moved: list[str] = []
+    rules = ""
+    for match in re.finditer(r"\(class\s+" + token, text):
+        if match.start() < pos:
+            continue
+        block, consumed = _extract_block(text, match.start())
+        # The net names run up to the class's first sub-block: the first "(" outside a quoted name.
+        head_end, quoted = len(block), False
+        for index, char in enumerate(block[1:], start=1):
+            if char == '"':
+                quoted = not quoted
+            elif char == "(" and not quoted:
+                head_end = index
+                break
+        head, rest = block[:head_end], block[head_end:]
+
+        def keep(m: re.Match[str]) -> str:
+            if unquote(m.group(1)) in names:
+                moved.append(m.group(1))
+                return ""
+            return m.group(0)
+
+        before = len(moved)
+        kept = re.sub(r"\s" + token, keep, head[len(match.group(0)) :])
+        if len(moved) > before and not rules:
+            rules = rest
+        out.append(text[pos : match.start()] + match.group(0) + kept + rest)
+        pos = match.start() + consumed
+    out.append(text[pos:])
+    result = "".join(out)
+    if not moved:
+        return result
+    network = re.search(r"\(network\b", result)
+    if network is None:
+        return result
+    _, consumed = _extract_block(result, network.start())
+    close = network.start() + consumed - 1
+    extra = f"  (class {_EXCLUDED_CLASS} {' '.join(dict.fromkeys(moved))}\n      {rules.strip()[:-1].rstrip()}\n    )\n  "
+    return result[:close] + extra + result[close:]
+
