+def _drop_dsn_nets(text: str, names: set[str]) -> str:
+    """The DSN without these nets: their (net ...) blocks go, and their names from the (class ...) lists."""
+    from ..utils.sexpr import _extract_block
+
+    def unquote(token: str) -> str:
+        return token[1:-1] if len(token) >= 2 and token[0] == token[-1] == '"' else token
+
+    token = r'("(?:[^"\\]|\\.)*"|[^\s()]+)'
+    out: list[str] = []
+    pos = 0
+    for match in re.finditer(r"\((net|class)\s+" + token, text):
+        if match.start() < pos:
+            continue
+        kind, name = match.group(1), unquote(match.group(2))
+        block, consumed = _extract_block(text, match.start())
+        if kind == "net" and name in names:
+            out.append(text[pos : match.start()])
+            pos = match.start() + consumed
+        elif kind == "class":
+            # The net names run up to the class's first sub-block: the first "(" outside a quoted name.
+            head_end, quoted = len(block), False
+            for index, char in enumerate(block[1:], start=1):
+                if char == '"':
+                    quoted = not quoted
+                elif char == "(" and not quoted:
+                    head_end = index
+                    break
+            head, rest = block[:head_end], block[head_end:]
+            kept = re.sub(r"\s" + token, lambda m: "" if unquote(m.group(1)) in names else m.group(0), head[len(match.group(0)):])
+            out.append(text[pos : match.start()] + match.group(0) + kept + rest)
+            pos = match.start() + consumed
+    out.append(text[pos:])
+    return "".join(out)
+
